# Application under test. Defaults to the public Sauce Demo site when unset.
BASE_URL=https://www.saucedemo.com

# Credentials for the sample suite (Sauce Demo public test accounts).
# Replace with your own application's test accounts. Never commit .env.
DEFAULT_USER_EMAIL=standard_user
DEFAULT_USER_PASSWORD=secret_sauce
LOCKED_USER_EMAIL=locked_out_user
LOCKED_USER_PASSWORD=secret_sauce

# Optional: Mailosaur mailbox API, used by tests/helpers/mailosaur.helper.ts
# for email OTP / verification-code flows. Leave blank if you do not use it.
MAILOSAUR_API_KEY=
MAILOSAUR_SERVER_ID=

# Optional: set to 1 only if your environment uses self-signed certificates.
ALLOW_SELF_SIGNED_CERTS=
